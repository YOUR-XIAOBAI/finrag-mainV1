# Paste into Streamlit Cloud > App settings > Secrets.
# In local development, save as .streamlit/secrets.toml (git-ignored).
APP_MODE = "api"
LLM_PROVIDER = "qwen"
LLM_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_MODEL = "qwen-plus"
LLM_API_KEY = ""
LLM_MAX_TOKENS = 512
LLM_TIMEOUT_SECONDS = 60
# Optional: set a password before inviting a small group of testers.
APP_ACCESS_PASSWORD = ""

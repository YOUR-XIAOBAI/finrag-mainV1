# Copy to .env for LOCAL use. Never commit the real .env.
APP_MODE=api
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=60
# Optional shared password for a small invitation-only trial.
APP_ACCESS_PASSWORD=

# DeepSeek alternative: replace all three provider/base/model settings.
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=your-own-key

# Other OpenAI-compatible providers require an explicit base URL and model.
# LLM_PROVIDER=custom
